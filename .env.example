# Copy this file to .env and fill in your own values.
# Never upload the real .env file to GitHub.

# --- The real AI: NVIDIA Nemotron on Nebius Token Factory ---
NEBIUS_API_KEY=paste-your-key-here
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# --- Practice mode ---
# While you don't have a key yet, set PRACTICE_MODE=1 and leave NEBIUS_API_KEY empty.
# Every AI feature then gives pretend answers (clearly labelled), so you can test the page.
# It switches itself off as soon as NEBIUS_API_KEY has a real key.
PRACTICE_MODE=0

PORT=8787
