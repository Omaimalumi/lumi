# Copy this file to .env and fill in your own values.
# Never upload the real .env file to GitHub.

# --- The real AI: Google Gemini (free key at https://aistudio.google.com/apikey) ---
AI_API_KEY=paste-your-key-here
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Backup model, tried once when the main model is busy or too slow. Leave empty to turn off.
AI_FALLBACK_MODEL=gemini-3.5-flash

# --- Practice mode ---
# While you don't have a key yet, set PRACTICE_MODE=1 and leave AI_API_KEY empty.
# Every AI feature then gives pretend answers (clearly labelled), so you can test the page.
# It switches itself off as soon as AI_API_KEY has a real key.
PRACTICE_MODE=0

PORT=8787
